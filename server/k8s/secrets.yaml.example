# ==============================================
# Kubernetes Secrets 템플릿
# ==============================================
# 이 파일을 secrets.yaml로 복사하고 실제 값으로 변경하세요
# cp secrets.yaml.example secrets.yaml
#
# IMPORTANT: secrets.yaml은 절대 Git에 커밋하지 마세요!
# .gitignore에 추가되어 있는지 확인하세요.
#
# 실제 값은 base64로 인코딩해야 합니다:
# echo -n "your-value" | base64

apiVersion: v1
kind: Secret
metadata:
  name: dailymotion-secrets
type: Opaque
data:
  # PostgreSQL 연결 URL
  # 예: postgresql://user:password@host:5432/dbname
  database-url: cG9zdGdyZXNxbDovL3VzZXI6cGFzc3dvcmRAaG9zdDo1NDMyL2RibmFtZQ==

  # ODSAY API 키
  odsay-api-key: eW91ci1vZHNheS1hcGkta2V5LWhlcmU=

  # JWT Secret Key (최소 32자)
  secret-key: eW91ci1zdXBlci1zZWNyZXQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9u

  # NHN Cloud Access Key (선택 사항)
  nhn-cloud-access-key: eW91ci1uaG4tYWNjZXNzLWtleQ==

  # NHN Cloud Secret Key (선택 사항)
  nhn-cloud-secret-key: eW91ci1uaG4tc2VjcmV0LWtleQ==

---
# 시크릿 생성 명령어 예시:
# kubectl create secret generic dailymotion-secrets \
#   --from-literal=database-url='postgresql://user:password@host:5432/dbname' \
#   --from-literal=odsay-api-key='your-odsay-api-key' \
#   --from-literal=secret-key='your-super-secret-key-minimum-32-chars' \
#   --dry-run=client -o yaml > secrets.yaml
