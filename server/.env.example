# ==============================================
# 데일리모션 FastAPI 환경변수 템플릿
# ==============================================
# 이 파일을 .env로 복사하고 실제 값으로 변경하세요
# cp .env.example .env

# ----------------------------------------------
# 애플리케이션 설정
# ----------------------------------------------
APP_NAME=데일리모션 API
APP_VERSION=1.0.0
DEBUG=false

# ----------------------------------------------
# 데이터베이스 설정 (PostgreSQL + PostGIS)
# ----------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dailymotion
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=dailymotion

# ----------------------------------------------
# API 키 (ODSAY 대중교통 정보)
# ----------------------------------------------
ODSAY_API_KEY=your_odsay_api_key_here

# ----------------------------------------------
# NHN Cloud 설정 (선택 사항)
# ----------------------------------------------
NHN_CLOUD_ACCESS_KEY=your_nhn_access_key_here
NHN_CLOUD_SECRET_KEY=your_nhn_secret_key_here
NHN_CLOUD_REGION=kr1

# ----------------------------------------------
# 보안 설정
# ----------------------------------------------
# JWT 토큰 서명에 사용되는 비밀키 (프로덕션에서는 강력한 랜덤 문자열 사용!)
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------
# CORS 설정
# ----------------------------------------------
# 허용할 Origin (쉼표로 구분, 프로덕션에서는 구체적인 도메인 사용)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ----------------------------------------------
# Redis (캐싱 및 세션) - 선택 사항
# ----------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------
# 로깅 설정
# ----------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----------------------------------------------
# 모니터링 설정 (선택 사항)
# ----------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090
