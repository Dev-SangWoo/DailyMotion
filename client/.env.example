# API Configuration
# API 기본 URL (개발/프로덕션 환경에 맞춰 변경)
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Phase 8: 목업 데이터 설정
# REACT_APP_USE_MOCK_API 옵션:
# - 'true': 항상 목업 데이터 사용 (Expo 개발 권장)
# - 'false': 항상 실제 API 사용
# - 미설정: 개발 환경(__DEV__)에서 자동으로 목업 데이터 사용
#
# 기본값: 미설정 (개발 환경에서 자동으로 목업 활성화)
REACT_APP_USE_MOCK_API=true

# 로깅 레벨
LOG_LEVEL=info
