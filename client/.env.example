# API Configuration
# API 기본 URL (개발/프로덕션 환경에 맞춰 변경)
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1

# Phase 8: 목업 데이터 설정
# REACT_APP_USE_MOCK_API 옵션:
# - 'true': 항상 목업 데이터 사용 (Expo 개발 권장)
# - 'false': 항상 실제 API 사용
# - 미설정: 개발 환경(__DEV__)에서 자동으로 목업 데이터 사용
#
# 기본값: 미설정 (개발 환경에서 자동으로 목업 활성화)
REACT_APP_USE_MOCK_API=true

# 로깅 레벨
LOG_LEVEL=info


# 카카오 MAP API 설정
# 카카오 개발자 콘솔(https://developers.kakao.com/)에서 REST API 키를 발급받아 입력하세요.
EXPO_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 카카오 맵 JavaScript SDK 키 
# JavaScript SDK를 사용하는 경우 JavaScript 키를 입력하세요.
# JavaScript 키가 없으면 REST API 키를 사용해도 됩니다.
EXPO_PUBLIC_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here



REACT_APP_API_BASE_URL=http://<PC_IP>:8000/api/v1
REACT_APP_API_SERVER=http://<PC_IP>:8000