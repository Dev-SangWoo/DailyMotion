	CONSTRAINT home_lat_valid CHECK (((home_latitude >= ('-90'::integer)::double precision) AND (home_latitude <= (90)::double precision))),
	CONSTRAINT home_lon_valid CHECK (((home_longitude >= ('-180'::integer)::double precision) AND (home_longitude <= (180)::double precision))),
	CONSTRAINT last_mile_positive CHECK ((last_mile_duration > 0)),
	CONSTRAINT work_lat_valid CHECK (((work_latitude >= ('-90'::integer)::double precision) AND (work_latitude <= (90)::double precision))),
	CONSTRAINT work_lon_valid CHECK (((work_longitude >= ('-180'::integer)::double precision) AND (work_longitude <= (180)::double precision)))
);
CREATE INDEX ix_commute_settings_user_id ON rds.commute_settings USING btree (user_id);


