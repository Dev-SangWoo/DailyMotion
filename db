-- DROP TABLE rds.average_duration;

CREATE TABLE rds.average_duration (
	id serial4 NOT NULL,
	segment_id varchar(100) NOT NULL,
	departure_hour int4 NOT NULL,
	day_of_week int4 NOT NULL,
	avg_duration_seconds int4 NOT NULL,
	sample_count int4 NOT NULL,
	transport_type varchar(20) NOT NULL,
	transport_name varchar(50) NULL,
	start_station_name varchar(100) NULL,
	end_station_name varchar(100) NULL,
	is_reliable int4 NOT NULL,
	created_at timestamp NOT NULL,
	updated_at timestamp NOT NULL,
	CONSTRAINT average_duration_pkey PRIMARY KEY (id),
	CONSTRAINT day_range_valid CHECK (((day_of_week >= 0) AND (day_of_week <= 6))),
	CONSTRAINT duration_positive CHECK ((avg_duration_seconds > 0)),
	CONSTRAINT hour_range_valid CHECK (((departure_hour >= 0) AND (departure_hour <= 23))),
	CONSTRAINT sample_count_non_negative CHECK ((sample_count >= 0))
);
CREATE INDEX ix_average_duration_segment_id ON rds.average_duration USING btree (segment_id);
CREATE INDEX ix_average_duration_updated_at ON rds.average_duration USING btree (updated_at);
CREATE INDEX ix_avg_duration_composite ON rds.average_duration USING btree (segment_id, departure_hour, day_of_week);


